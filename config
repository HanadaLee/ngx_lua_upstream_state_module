ngx_addon_name=ngx_lua_upstream_state_module

if [ $HTTP != NO ]; then

    ngx_module_type=HTTP
    ngx_module_name=ngx_http_lua_upstream_state_module
    ngx_module_srcs=" \
                    $ngx_addon_dir/src/ngx_http_lua_upstream_state_module.c \
                    "

    if [ -z "$NGX_LUA_LOC" ]; then
        ngx_lua_loc="../ngx_lua-*"
    else
        ngx_lua_loc="$NGX_LUA_LOC"
    fi

    ngx_module_incs="$ngx_addon_dir/src $ngx_lua_loc/src"

    . auto/module

fi

if [ $STREAM != NO -a $nginx_version -gt 1011001 ]; then

    ngx_module_type=STREAM
    ngx_module_name=ngx_stream_lua_upstream_state_module
    ngx_module_srcs=" \
                    $ngx_addon_dir/src/ngx_stream_lua_upstream_state_module.c \
                    "

    if [ -z "$NGX_STREAM_LUA_LOC" ]; then
        ngx_stream_lua_loc="../ngx_stream_lua-*"
    else
        ngx_stream_lua_loc="$NGX_STREAM_LUA_LOC"
    fi

    ngx_module_incs="$ngx_addon_dir/src $ngx_stream_lua_loc/src"

    . auto/module

fi
